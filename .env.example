# Copy to .env and replace every change-me value (for example: openssl rand -hex 24).
# A process refuses to start when a required value is missing and names the variable.

# Where PostgreSQL is. docker compose reads DATABASE_PORT, DATABASE_NAME and POSTGRES_* from this file too.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=billay

# Superuser. Used ONLY by migrate, seed and db:reset; the API never reads it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin

# Passwords of the two application roles. `npm run migrate` applies them; the API connects with them.
BILLAY_APP_PASSWORD=change-me-app-password
BILLAY_SERVICE_PASSWORD=change-me-service-password

# Shared secret of the platform reviewer scope over HTTP (X-Service-Token). At least 16 characters.
SERVICE_TOKEN=change-me-service-token

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# How many distinct tenants must share a pattern before it may become a global candidate.
PROMOTION_MIN_TENANTS=3
